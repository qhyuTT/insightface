PERSON_SEARCH_HOST=127.0.0.1
PERSON_SEARCH_PORT=8000
# Legacy development-only evidence credential when AUTH_ENABLED=false.
# Production evidence uses JWT scopes; do not configure a shared browser key.
# PERSON_SEARCH_EVIDENCE_TTL_SECONDS=600
PERSON_SEARCH_YOLOX_MODEL=models/yolox_tiny.onnx
PERSON_SEARCH_INSIGHTFACE_MODEL=buffalo_l
PERSON_SEARCH_INSIGHTFACE_ROOT=~/.insightface
# RK3588 native mode (all four paths are required when enabled).  Keep the
# default ONNX/OpenCV mode above for local development and T4 deployments.
# PERSON_SEARCH_INFERENCE_BACKEND=rknn
# PERSON_SEARCH_RKNN_RUNTIME_LIBRARY=/ssd/person-search/runtime/librknnrt.so
# PERSON_SEARCH_RKNN_YOLOX_MODEL=/ssd/person-search/models/rk3588/yolox_tiny.rknn
# PERSON_SEARCH_RKNN_FACE_DETECTION_MODEL=/ssd/person-search/models/rk3588/scrfd_10g_640.rknn
# PERSON_SEARCH_RKNN_FACE_RECOGNITION_MODEL=/ssd/person-search/models/rk3588/w600k_r50.rknn
PERSON_SEARCH_PREFER_CUDA=true
# Optional YOLOX ONNX Runtime tuning. Leave blank to use ONNX Runtime's
# native thread/device defaults. Values are non-negative integers; CUDA device
# IDs follow nvidia-smi -L. These knobs configure the YOLOX session (the
# InsightFace FaceAnalysis session keeps its own provider settings).
# PERSON_SEARCH_ORT_INTRA_OP_NUM_THREADS=4
# PERSON_SEARCH_ORT_INTER_OP_NUM_THREADS=1
# PERSON_SEARCH_ORT_CUDA_DEVICE_ID=0
PERSON_SEARCH_RTSP_OPEN_TIMEOUT_SECONDS=5
PERSON_SEARCH_RTSP_READ_TIMEOUT_SECONDS=5
# RK3588 uses the box's system OpenCV/GStreamer helper so MPP performs video
# decode before the Python 3.11 service receives BGR frames.
# PERSON_SEARCH_VIDEO_BACKEND=gstreamer
# PERSON_SEARCH_GSTREAMER_PYTHON=/usr/bin/python3
# PERSON_SEARCH_GSTREAMER_HELPER=/ssd/person-search/scripts/rk3588_gstreamer_capture.py
# PERSON_SEARCH_GSTREAMER_LATENCY_MS=100
# PERSON_SEARCH_GSTREAMER_RTSP_CODEC=auto
PERSON_SEARCH_FACE_DETECTION_THRESHOLD=0.45
PERSON_SEARCH_MIN_ENROLLMENT_DETECTION_SCORE=0.60
PERSON_SEARCH_TINY_FACE_ENABLED=true
# Keep this true while far-face thresholds are being measured. Shadow hits are
# diagnostic-only and cannot mark a target found; the T4 deployment script also
# requires a separate explicit physical-action switch before turning it off.
PERSON_SEARCH_TINY_FACE_SHADOW_MODE=true
PERSON_SEARCH_TINY_FACE_MIN_PX=48
PERSON_SEARCH_TINY_FACE_DETECTION_THRESHOLD=0.65
PERSON_SEARCH_TINY_FACE_SIMILARITY_THRESHOLD=0.64
PERSON_SEARCH_TINY_FACE_AGGREGATE_SIMILARITY_THRESHOLD=0.68
PERSON_SEARCH_TINY_FACE_EVIDENCE_REQUIRED=6
PERSON_SEARCH_TINY_FACE_CONSISTENT_VOTES_REQUIRED=5
PERSON_SEARCH_TINY_FACE_EVIDENCE_WINDOW_SECONDS=3.0
PERSON_SEARCH_TINY_FACE_MIN_TOP1_MARGIN=0.08
PERSON_SEARCH_ROI_PERSON_FRACTION=0.5
# One 1280 pass instead of Auto's 128+640. Measured on a T4: 57ms against 108ms,
# and a higher det_score at every face size, because each extra ONNX input shape
# costs ~30ms of re-planning -- more than the scale's own inference. Raise
# PERSON_SEARCH_FACE_DEEP_SCAN_EVERY_N above 1 only if face_full p95 on the panel
# still exceeds what the loop can absorb.
# This is the SEARCH scale only. It must stay off the enrollment path: a lone 1280
# pass upscales a close-up past SCRFD's stride-32 anchors and misses it outright,
# which turns every enrollment into no_face. Enrollment has its own scale below.
PERSON_SEARCH_FACE_DETECTION_SIZE=1280
PERSON_SEARCH_FACE_DETECTION_EXTRA_SCALE_CUDA=0
# 0 keeps Auto's 128+640 for enrollment photos, which are close-ups by definition.
# Only override with measurements taken on real enrollment photos.
PERSON_SEARCH_ENROLLMENT_DETECTION_SIZE=0
PERSON_SEARCH_FACE_DEEP_SCAN_EVERY_N=1
PERSON_SEARCH_CAMERA_MOTION_COMPENSATION=true
PERSON_SEARCH_EMBEDDING_FLIP_TTA=true
# conservative keeps today's far-face bar (6 frames over 3s, median). Switch to
# responsive for a faster verdict (4 frames over 2s, top-K mean, det 0.55) -- but
# not before the thresholds are calibrated with person-search-eval
# --dump-similarities, because responsive is a false-accept trade.
PERSON_SEARCH_MATCH_PROFILE=conservative
PERSON_SEARCH_FACE_TIER_HYSTERESIS_PX=6
PERSON_SEARCH_TINY_FACE_ALLOW_RELAXED_ASSOCIATION=true
PERSON_SEARCH_MAX_ABS_ROLL_DEGREES=25
PERSON_SEARCH_MAX_YAW_PROXY=0.45
PERSON_SEARCH_SIMILARITY_THRESHOLD=0.55
# Runtime cost guards. roi_max_tracks_per_pass is the number of person tracks
# considered in one ROI pass; roi_batch_size is only the number of same-scale
# crops grouped into one detector call and is not a track-count limit.
PERSON_SEARCH_ROI_MAX_TRACKS_PER_PASS=3
PERSON_SEARCH_ROI_BATCH_ENABLED=true
PERSON_SEARCH_ROI_BATCH_SIZE=8
PERSON_SEARCH_ARCFACE_MICRO_BATCH_SIZE=16
PERSON_SEARCH_MAX_FACES_PER_FRAME=64
PERSON_SEARCH_TARGET_LOOP_HZ=10
PERSON_SEARCH_MIN_PROCESSED_FPS=2
PERSON_SEARCH_BUDGET_CREDIT_MAX_FRAMES=2
# Terminal search metadata is retained for request reconciliation, without
# retaining biometric arrays. Tune the TTL/LRU and enrollment cap to memory and
# API usage; all three values are bounded and validated at startup.
PERSON_SEARCH_TERMINAL_SESSION_TTL_SECONDS=600
PERSON_SEARCH_MAX_RETAINED_SESSIONS=100
PERSON_SEARCH_MAX_ENROLLED_TARGETS=100

# Unified identity. Required in production; no user database/private signing key here.
PERSON_SEARCH_AUTH_ENABLED=true
PERSON_SEARCH_EXECUTOR_ID=executor-01
PERSON_SEARCH_AUTH_ISSUER=https://dispatch.example.invalid
PERSON_SEARCH_AUTH_JWKS_URL=https://dispatch.example.invalid/.well-known/jwks.json
PERSON_SEARCH_AUTH_STATUS_URL=https://dispatch.example.invalid/api/v1/auth/token-status
PERSON_SEARCH_AUTH_AUDIENCE=insightface:executor-01
# Private CA certificate, if applicable; TLS verification always remains enabled.
# PERSON_SEARCH_AUTH_CA_FILE=/run/secrets/dispatch-ca.crt
# For one-off authenticated readiness only; replace with fresh JWT before each check.
# PERSON_SEARCH_PROBE_TOKEN_FILE=/run/executor-probe.jwt
