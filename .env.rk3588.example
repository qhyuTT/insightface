# EIS100-RK3588 baseline configuration.
# Copy this file to .env on the device after installing the matching RKNN Lite
# runtime.  Paths are examples; keep model artifacts on the SSD when possible.
PERSON_SEARCH_HOST=127.0.0.1
PERSON_SEARCH_PORT=8000
PERSON_SEARCH_INFERENCE_BACKEND=rknn
PERSON_SEARCH_RKNN_PERSON_MODEL=/opt/person-search/models/yolox_tiny.rknn
PERSON_SEARCH_RKNN_FACE_DETECTION_MODEL=/opt/person-search/models/scrfd.rknn
PERSON_SEARCH_RKNN_FACE_RECOGNITION_MODEL=/opt/person-search/models/arcface.rknn
# Required Python entry point after the board-specific SCRFD/ArcFace adapter is
# implemented: package.module:create_adapter. Blank intentionally fails /readyz.
PERSON_SEARCH_RKNN_FACE_ADAPTER=
PERSON_SEARCH_INSIGHTFACE_ALLOW_DOWNLOAD=false
PERSON_SEARCH_RKNN_CORE_MASK=7
PERSON_SEARCH_RKNN_PERSON_INPUT_LAYOUT=nchw
PERSON_SEARCH_RKNN_PERSON_INPUT_DTYPE=float32
PERSON_SEARCH_RKNN_PERSON_SHA256=
PERSON_SEARCH_RKNN_FACE_DETECTION_SHA256=
PERSON_SEARCH_RKNN_FACE_RECOGNITION_SHA256=

# Start with one stream and bounded work on the NPU.  Increase only after a
# hardware benchmark confirms latency and thermals.
PERSON_SEARCH_PERSON_DETECTION_HZ_RKNN=5
PERSON_SEARCH_FACE_DETECTION_HZ_RKNN=5
PERSON_SEARCH_FRAME_QUEUE_SIZE=2
PERSON_SEARCH_CAPTURE_BACKEND=gstreamer
# Confirm these names with gst-inspect-1.0 on the vendor image. H.265 cameras
# should use h265 and the matching decoder plugin when it differs.
PERSON_SEARCH_GSTREAMER_RTSP_CODEC=h264
PERSON_SEARCH_GSTREAMER_DECODER=mppvideodec
PERSON_SEARCH_GSTREAMER_LATENCY_MS=100
PERSON_SEARCH_PREVIEW_ENABLED=false
PERSON_SEARCH_PREVIEW_FPS=2
PERSON_SEARCH_MAX_CAPTURE_WIDTH=1920
PERSON_SEARCH_MAX_CAPTURE_HEIGHT=1080
PERSON_SEARCH_RTSP_TRANSPORT=tcp
# Replace with the exact camera host(s), IP(s), or camera VLAN CIDR. Leaving
# this empty permits arbitrary RTSP destinations and is not recommended when
# the API is reachable by other machines.
PERSON_SEARCH_RTSP_ALLOWED_HOSTS=192.168.31.0/24
PERSON_SEARCH_MAX_ENROLLED_TARGETS=20
