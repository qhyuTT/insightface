[Unit]
Description=Person Search RK3588 native service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/ssd/person-search
Environment=PYTHONUNBUFFERED=1
Environment=PERSON_SEARCH_HOST=0.0.0.0
Environment=PERSON_SEARCH_PORT=18080
Environment=PERSON_SEARCH_INFERENCE_BACKEND=rknn
Environment=PERSON_SEARCH_VIDEO_BACKEND=gstreamer
Environment=PERSON_SEARCH_PREFER_CUDA=false
Environment=PERSON_SEARCH_RKNN_RUNTIME_LIBRARY=/ssd/person-search/runtime/librknnrt.so
Environment=PERSON_SEARCH_RKNN_YOLOX_MODEL=/ssd/person-search/models/rk3588/yolox_tiny.rknn
Environment=PERSON_SEARCH_RKNN_FACE_DETECTION_MODEL=/ssd/person-search/models/rk3588/scrfd_10g_640.rknn
Environment=PERSON_SEARCH_RKNN_FACE_RECOGNITION_MODEL=/ssd/person-search/models/rk3588/w600k_r50.rknn
Environment=PERSON_SEARCH_GSTREAMER_PYTHON=/usr/bin/python3
Environment=PERSON_SEARCH_GSTREAMER_HELPER=/ssd/person-search/scripts/rk3588_gstreamer_capture.py
Environment=PERSON_SEARCH_FACE_DETECTION_SIZE=640
Environment=PERSON_SEARCH_ENROLLMENT_DETECTION_SIZE=640
Environment=PERSON_SEARCH_FACE_DETECTION_EXTRA_SCALE_CPU=0
Environment=PERSON_SEARCH_TINY_FACE_ENABLED=true
Environment=PERSON_SEARCH_TINY_FACE_SHADOW_MODE=true
EnvironmentFile=-/ssd/person-search/.env
ExecStart=/ssd/person-search/.venv/bin/person-search-api
Restart=on-failure
RestartSec=3
TimeoutStopSec=15

[Install]
WantedBy=default.target
