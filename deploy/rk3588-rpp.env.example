# Copy to the RK3588 checkout as .env for a side-by-side stage on port 18081.
# runtime.env must contain PERSON_SEARCH_EVIDENCE_API_KEY with the same value
# as dispatch's DISPATCH_INSIGHTFACE_EVIDENCE_API_KEY. Keep both secret values
# out of this example file and source control.
PERSON_SEARCH_RPP_ROOT=/ssd/person-search-rpp
PERSON_SEARCH_RUNTIME_ENV_FILE=/ssd/person-search-rpp/runtime.env
PERSON_SEARCH_PORT=18081
PERSON_SEARCH_IMAGE_TAG=stage
PERSON_SEARCH_BUILD_REVISION=local
PERSON_SEARCH_PREVIEW_HZ=15
