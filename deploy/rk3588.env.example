# Native EIS100 RK3588 service. Copy to /ssd/person-search/.env on the box and
# fill in the runtime/model paths if they differ. Do not commit camera credentials.
PERSON_SEARCH_HOST=0.0.0.0
PERSON_SEARCH_PORT=18080
PERSON_SEARCH_INFERENCE_BACKEND=rknn
PERSON_SEARCH_VIDEO_BACKEND=gstreamer
PERSON_SEARCH_PREFER_CUDA=false
PERSON_SEARCH_RKNN_RUNTIME_LIBRARY=/ssd/person-search/runtime/librknnrt.so
PERSON_SEARCH_RKNN_YOLOX_MODEL=/ssd/person-search/models/rk3588/yolox_tiny_640x384.rknn
PERSON_SEARCH_PERSON_INPUT_WIDTH=640
PERSON_SEARCH_PERSON_INPUT_HEIGHT=384
PERSON_SEARCH_RKNN_FACE_DETECTION_MODEL=/ssd/person-search/models/rk3588/scrfd_10g_1280x736_int8.rknn
PERSON_SEARCH_RKNN_ENROLLMENT_FACE_DETECTION_MODEL=/ssd/person-search/models/rk3588/scrfd_10g_640.rknn
PERSON_SEARCH_RKNN_FACE_RECOGNITION_MODEL=/ssd/person-search/models/rk3588/w600k_r50.rknn
PERSON_SEARCH_GSTREAMER_PYTHON=/usr/bin/python3
PERSON_SEARCH_GSTREAMER_HELPER=/ssd/person-search/scripts/rk3588_gstreamer_capture.py
PERSON_SEARCH_GSTREAMER_LATENCY_MS=500
PERSON_SEARCH_GSTREAMER_DROP_ON_LATENCY=false
PERSON_SEARCH_GSTREAMER_OUTPUT_FORMAT=nv12
PERSON_SEARCH_GSTREAMER_NV12_CONVERTER=auto
PERSON_SEARCH_RGA_RUNTIME_LIBRARY=/lib/aarch64-linux-gnu/librga.so.2
PERSON_SEARCH_GSTREAMER_RTSP_CODEC=auto
PERSON_SEARCH_RTSP_TRANSPORT=tcp
PERSON_SEARCH_FACE_DETECTION_SIZE=640
PERSON_SEARCH_ENROLLMENT_DETECTION_SIZE=640
PERSON_SEARCH_FACE_DETECTION_EXTRA_SCALE_CPU=0
PERSON_SEARCH_FACE_DEEP_SCAN_EVERY_N=1
PERSON_SEARCH_TINY_FACE_ENABLED=true
PERSON_SEARCH_TINY_FACE_SHADOW_MODE=true
PERSON_SEARCH_EMBEDDING_FLIP_TTA=true
# 7 = all three NPU cores per context; 0 = vendor default (one core).
PERSON_SEARCH_RKNN_CORE_MASK=7
# Fixed camera: motion compensation is a 4K cvtColor+resize for nothing.
PERSON_SEARCH_CAMERA_MOTION_COMPENSATION=false
PERSON_SEARCH_STAGGER_FULL_FRAME_DETECTION=true
PERSON_SEARCH_PERSON_DETECTION_HZ_CUDA=4
PERSON_SEARCH_FACE_DETECTION_HZ_CUDA=4
# ROI budget denominator; this does not throttle the main loop.
PERSON_SEARCH_TARGET_LOOP_HZ=4
PERSON_SEARCH_MIN_PROCESSED_FPS=2
PERSON_SEARCH_MATCH_PROFILE=transit
PERSON_SEARCH_FACE_TRACK_BUFFER_SECONDS=2.5
# Identity trust; executor ID must match the dispatch registry.
PERSON_SEARCH_AUTH_ENABLED=true
PERSON_SEARCH_EXECUTOR_ID=executor-01
PERSON_SEARCH_AUTH_ISSUER=https://dispatch.example.invalid
PERSON_SEARCH_AUTH_JWKS_URL=https://dispatch.example.invalid/.well-known/jwks.json
PERSON_SEARCH_AUTH_STATUS_URL=https://dispatch.example.invalid/api/v1/auth/token-status
PERSON_SEARCH_AUTH_AUDIENCE=insightface:executor-01
# PERSON_SEARCH_AUTH_CA_FILE=/run/secrets/dispatch-ca.crt
